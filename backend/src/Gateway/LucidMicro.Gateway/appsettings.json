{
  "Lucid": {
    "Observability": {
      "OpenTelemetry": {
        "ServiceName": "LucidMicro.Gateway",
        "ServiceVersion": "1.0.0",
        "ServiceInstanceId": "",
        "OtlpEndpoint": "",
        "EnableConsoleExporter": false,
        "Metrics": {
          "Enabled": true,
          "EnableConsoleExporter": false
        }
      }
    },
    "Cors": {
      "Enabled": true,
      "AllowedOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:5174"
      ],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Authorization",
        "Content-Type",
        "X-Correlation-Id",
        "X-Tenant-Id"
      ],
      "AllowCredentials": false
    },
    "Logging": {
      "Serilog": {
        "ApplicationName": "LucidMicro.Gateway",
        "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {ApplicationName} {EnvironmentName} [{TraceId}/{SpanId}] {Message:lj}{NewLine}{Exception}",
        "File": {
          "Enabled": false,
          "Path": "logs/lucid-micro-gateway-.log",
          "RollingInterval": "Day",
          "RetainedFileCountLimit": 31
        },
        "Loki": {
          "Enabled": false,
          "Uri": "http://localhost:3100",
          "Labels": {
            "app": "lucid_micro",
            "service": "gateway"
          }
        },
        "RequestLogging": {
          "MessageTemplate": "HTTP {RequestMethod} {RequestPath} responded {StatusCode} in {Elapsed:0.0000} ms"
        }
      }
    },
    "Gateway": {
      "ServiceDiscovery": {
        "Enabled": false,
        "RefreshIntervalSeconds": 10,
        "LoadBalancingPolicy": "RoundRobin",
        "Clusters": {
          "identity": "identity",
          "notification": "notification"
        }
      }
    },
    "ServiceDiscovery": {
      "Consul": {
        "Address": "http://localhost:8500",
        "Datacenter": "",
        "Token": "",
        "OnlyPassing": true,
        "CacheDurationSeconds": 10,
        "RequestTimeoutSeconds": 5
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:49753/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:49853/"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
