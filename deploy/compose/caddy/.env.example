# Caddy image.
# This image is built from deploy/docker/caddy/Dockerfile with the Cloudflare DNS plugin.
CADDY_IMAGE=lucidmicro/caddy-cloudflare:local

# ACME account email used by Caddy when requesting public certificates.
CADDY_ACME_EMAIL=admin@example.xyz

# Cloudflare API token for DNS-01 certificate challenges.
# Required permissions: Zone / Zone / Read and Zone / DNS / Edit for example.xyz.
CLOUDFLARE_API_TOKEN=change-me

# Public HTTP/HTTPS ports on the Docker host.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
