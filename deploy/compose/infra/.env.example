# Consul image.
# Pin the image tag in server deployments instead of using latest.
CONSUL_IMAGE=hashicorp/consul:1.21.3

# Consul HTTP API / UI port exposed on the Docker host.
# Keep bind address on 127.0.0.1 unless the server firewall and ACL are ready.
# For temporary public access in a development server, set CONSUL_HTTP_BIND=0.0.0.0
# and restrict inbound traffic with the server firewall whenever possible.
CONSUL_HTTP_BIND=127.0.0.1
CONSUL_HTTP_PORT=8500

# PostgreSQL image and credentials.
# App containers use Host=postgres;Port=5432 through the shared Docker network.
POSTGRES_IMAGE=postgres:18.4
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lucid_micro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Redis image and password.
# App containers use redis:6379,password=<REDIS_PASSWORD>,abortConnect=false.
REDIS_IMAGE=redis:8.8.0-alpine
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# RabbitMQ image and credentials.
# App containers use amqp://<user>:<password>@rabbitmq:5672/.
# RabbitMQ user, password, or vhost special characters need URL encoding in amqp:// URIs.
RABBITMQ_IMAGE=rabbitmq:4.3.1-management
RABBITMQ_AMQP_BIND=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_BIND=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=/

# Observability images.
LOKI_IMAGE=grafana/loki:3.5.1
TEMPO_IMAGE=grafana/tempo:2.8.2
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.128.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0

# Loki HTTP API port exposed on the Docker host.
LOKI_HTTP_BIND=127.0.0.1
LOKI_HTTP_PORT=3100

# Tempo HTTP query port exposed on the Docker host.
TEMPO_HTTP_BIND=127.0.0.1
TEMPO_HTTP_PORT=3200

# OpenTelemetry Collector OTLP ports exposed on the Docker host.
# App containers use http://otel-collector:4317 through the shared Docker network.
OTEL_COLLECTOR_OTLP_GRPC_BIND=127.0.0.1
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_BIND=127.0.0.1
OTEL_COLLECTOR_OTLP_HTTP_PORT=4318

# Prometheus HTTP UI/API port exposed on the Docker host.
PROMETHEUS_HTTP_BIND=127.0.0.1
PROMETHEUS_HTTP_PORT=9090

# Grafana UI port exposed on the Docker host.
GRAFANA_HTTP_BIND=127.0.0.1
GRAFANA_HTTP_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
