# 对外访问地址。
# ADMIN_ORIGIN 是浏览器访问 admin-web 的源地址，用于 Gateway CORS。
# GATEWAY_PUBLIC_URL 会在 Vite 构建时写入 admin-web 静态资源。
ADMIN_ORIGIN=https://cloud.example.xyz
GATEWAY_PUBLIC_URL=https://api.example.xyz
# 本地 Admin dev server 调已发布 Gateway 时，需要把本地页面 origin 加到 Gateway CORS。
LOCAL_ADMIN_ORIGIN=http://localhost:5173
LOCAL_ADMIN_ORIGIN_127=http://127.0.0.1:5173
LOCAL_ADMIN_ORIGIN_ALT=http://localhost:5174
LOCAL_ADMIN_ORIGIN_ALT_127=http://127.0.0.1:5174

# 应用镜像。
# 本地构建可保留默认 local 镜像；服务器通过 GitHub Actions/GHCR 部署时改为 ghcr.io 镜像。
IDENTITY_API_IMAGE=lucidmicro/identity-api:local
NOTIFICATION_API_IMAGE=lucidmicro/notification-api:local
GATEWAY_IMAGE=lucidmicro/gateway:local
ADMIN_WEB_IMAGE=lucidmicro/admin-web:local

# 使用 ghcr.io 镜像时，取消下面的注释并删除上面的 local 镜像。
# IDENTITY_API_IMAGE=ghcr.io/sansayyy/lucidmicro/identity-api:main
# NOTIFICATION_API_IMAGE=ghcr.io/sansayyy/lucidmicro/notification-api:main
# GATEWAY_IMAGE=ghcr.io/sansayyy/lucidmicro/gateway:main
# ADMIN_WEB_IMAGE=ghcr.io/sansayyy/lucidmicro/admin-web:main

# 应用副本数。
# 服务器双节点部署时改为 2；GitHub Actions 部署会按这里的值执行 docker compose --scale。
IDENTITY_API_REPLICAS=1
NOTIFICATION_API_REPLICAS=1

# Docker 宿主机暴露端口。
# 容器内部端口保持固定：admin-web=80，后端服务=8080。
# 使用 Caddy 时保持 127.0.0.1，只允许 Caddy 通过 Docker 网络访问容器。
# 如果不用 Caddy、需要公网直连这些端口，再改成 0.0.0.0 并配置防火墙。
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8088
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=49953

# 基础设施连接串。
# 使用 deploy/compose/infra 时，app 容器通过共享 Docker 网络访问这些服务名。
# 使用 amqp:// URI 时，RabbitMQ 用户名或密码中的特殊字符需要 URL encode。
IDENTITY_CONNECTION_STRING=Host=postgres;Port=5432;Database=lucid_micro_identity;Username=postgres;Password=change-me
NOTIFICATION_CONNECTION_STRING=Host=postgres;Port=5432;Database=lucid_micro_notification;Username=postgres;Password=change-me
REDIS_CONNECTION_STRING=redis:6379,password=change-me,abortConnect=false
RABBITMQ_CONNECTION_STRING=amqp://admin:change-me@rabbitmq:5672/
# 使用 deploy/compose/infra 中的 Consul 时，app 容器通过共享 Docker 网络访问 consul。
CONSUL_ADDRESS=http://consul:8500
# Consul ACL app token. 使用 infra compose 启用 ACL 后，填入 lucid-app policy 对应 token 的 SecretID。
CONSUL_TOKEN=change-me-after-consul-acl-bootstrap

# Loki 日志推送。
# 使用 deploy/compose/infra 中的 Loki 时，app 容器通过共享 Docker 网络访问 loki。
LOKI_ENABLED=false
LOKI_URI=http://loki:3100

# OpenTelemetry traces and metrics.
# 使用 deploy/compose/infra 中的 OpenTelemetry Collector 时，app 容器通过共享 Docker 网络访问 otel-collector。
OTEL_OTLP_ENDPOINT=http://otel-collector:4317

# JWT。
# 服务器部署不要使用开发默认签名密钥。
JWT_ISSUER=LucidMicro.Identity
JWT_AUDIENCE=LucidMicro.Admin
JWT_REFRESH_AUDIENCE=LucidMicro.Admin.Refresh
JWT_SIGNING_KEY=change-me-to-a-secure-production-signing-key-at-least-32-bytes
